              "raw": "{\n  \"GatewayARN\": \"<string>\",\n  \"AverageUploadRateLimitInBitsPerSec\": \"<integer>\",\n  \"AverageDownloadRateLimitInBitsPerSec\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
